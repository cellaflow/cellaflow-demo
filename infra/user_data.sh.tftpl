#!/bin/bash
# Boot script for the demo instance (docs/design.md). Rendered by Terraform.
set -euxo pipefail

# 1 GB of RAM: give the image builds and the engine room to breathe.
fallocate -l 1G /swapfile && chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile
echo '/swapfile none swap sw 0 0' >> /etc/fstab

apt-get update -y
apt-get install -y docker.io docker-compose-v2 dnsutils
systemctl enable --now docker

install -d -m 0755 /opt/demo /opt/demo/api
%{ for name, content in files_b64 ~}
echo "${content}" | base64 -d | gunzip > "/opt/demo/${name}"
%{ endfor ~}
chmod +x /opt/demo/wipe-engine.sh

cat > /opt/demo/.env <<'ENV'
DEMO_HOSTNAME=${hostname}
DEMO_ALLOWED_ORIGINS=${allowed_origins}
DEMO_AWS_REGION=${region}
ENV

# Let's Encrypt allows only 5 failed validations per hostname per hour, so Caddy does not start
# until public DNS points at this instance (checked against two resolvers). Waits up to 2 hours.
cd /opt/demo
docker compose -p demo -f compose.prod.yml up -d --build --wait engine api
for wait in $(seq 1 240); do
  # Read every pass: the Elastic IP is attached after boot starts, so an address read once could be
  # the temporary one and never match.
  imds_token=$(curl -s -X PUT http://169.254.169.254/latest/api/token -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
  my_ip=$(curl -s -H "X-aws-ec2-metadata-token: $imds_token" http://169.254.169.254/latest/meta-data/public-ipv4)
  if [ "$(dig +short "${hostname}" @1.1.1.1 | tail -1)" = "$my_ip" ] && \
     [ "$(dig +short "${hostname}" @8.8.8.8 | tail -1)" = "$my_ip" ]; then
    break
  fi
  sleep 30
done
docker compose -p demo -f compose.prod.yml up -d caddy

echo '0 9 * * * root /opt/demo/wipe-engine.sh >> /var/log/demo-wipe.log 2>&1' > /etc/cron.d/demo-wipe
