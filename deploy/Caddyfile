# TLS is automatic. Caddy sets X-Forwarded-For to the connecting address and ignores any value the
# client sent, which is what the API's per-address rate limit relies on.
#
# The email gives Caddy its default issuers: Let's Encrypt, then ZeroSSL if Let's Encrypt refuses.
# Let's Encrypt allows five certificates per hostname per week.
{
	email druhin@cellaflow.com
}

# `handle` blocks, not bare directives: Caddy orders directives by type, not by position, and runs
# `respond` before `reverse_proxy`, so a bare `respond 404` answered every request.
# DEMO_HOSTNAMES is a comma-separated list; each name gets its own certificate.
{$DEMO_HOSTNAMES} {
	encode gzip
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		respond 404
	}
}
